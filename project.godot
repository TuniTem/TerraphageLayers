; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Terraphage Layer Editor"
run/main_scene="uid://c3scnkvykne7q"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://icon.svg"

[autoload]

Util="*uid://dhqqejsdf4hqa"
File="*uid://d3k2kwm6osox1"
InputHelper="*uid://7tafmwgwnvra"
Debug="*uid://bfxluiesgnvul"
Global="*uid://bgdsl02fcljs5"

[display]

window/size/viewport_width=1800
window/size/viewport_height=1026
window/size/window_width_override=1200
window/size/window_height_override=684
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

