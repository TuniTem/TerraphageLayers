[node name="Help" type="Label" parent="Control" unique_id=1590940469]
z_index = 604
layout_mode = 0
offset_left = -241.0
offset_top = 38.0
offset_right = 416.0
offset_bottom = 992.0
theme_override_font_sizes/font_size = 21
text = "NOTES:
     - Drag objects from the right to create layer
     - Each object has 3 variations you can cycle through with [R] 
     - The very top is the start of the layer
     - Autosave every 2m
     - Please set the valid enter/exit positons on the top/bottom

CONTROLS: 
     L Click (hold) - pick up/hold obj
     Scroll (w/o held item) - Move scene vertically
     Tab - See collisions (Box at mouse cursor is player size when
                falling, SHIFT to see player size when standing)
     L - Set layer end at mouse position
     NOTE: Cannot be above lowest object
     B - Hide/show enter and exit buttons
     Ctrl + S - Save
     Ctrl + Shift + S - Save as
     Ctrl + L  - Load save

     R (w/ held item) - go thru sprite variations 
     Backspace/del (w/ held item) - delete item
     Scroll (w/ held item)  - scale item (use only a lil pls)
     Q/E (w/ held item)  - Rotate L/R by 90 degrees
     +/- (w/ held item) - change item render layer (shift = faster)
     F (w/ held item) - Flip horizontal
     V (w/ held item) - Flip verical
     A/D (w/ held enemy) - Increase/decrease chance (shift = faster)

     ESC - toggle this menu"

